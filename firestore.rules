rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: authenticated users can read, user can edit their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isOwner(userId);
    }

    // Couple workspaces and subcollections (messages, memories, notes, timeline, pings)
    match /couples/{coupleId} {
      allow read, write: if isAuthenticated();

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Pair invitation codes
    match /invites/{code} {
      allow read, write: if isAuthenticated();
    }

    // Fallback: strictly deny unauthenticated access
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
