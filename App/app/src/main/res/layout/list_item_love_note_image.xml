<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">
            
            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="?attr/colorSurfaceVariant" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Love note content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic"
            android:gravity="center"
            android:alpha="0.8" />

        <!-- Voice Note Playback Row -->
        <LinearLayout
            android:id="@+id/layout_audio_playback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_whatsapp_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_play_audio"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_call_btn_round"
                android:src="@drawable/ic_play_arrow"
                app:tint="#FFFFFF"
                android:padding="6dp"
                android:contentDescription="Play Voice Note" />

            <TextView
                android:id="@+id/tv_audio_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="🎙️ Voice Note"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bloom_primary" />

            <TextView
                android:id="@+id/tv_audio_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0:00"
                android:textSize="12sp"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DATE"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOutline"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:gravity="end"
            android:alpha="0.5" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
