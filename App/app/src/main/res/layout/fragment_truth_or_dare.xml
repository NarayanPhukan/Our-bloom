<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btn_back_tod"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/playfair_display"
                    android:text="Truth or Dare 🍾✨"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tod_online_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Online &amp; Synced"
                    android:textColor="#4CAF50"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tod_add_custom"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+ Secret Card ✍️"
                android:textSize="11sp"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- Category Horizontal Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_tod_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="✨ All Decks" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_endless"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♾️ Endless Mode" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_spicy"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Spicy" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_sweet"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌸 Sweet" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_deep"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💭 Deep" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_playful"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😂 Playful" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_custom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✍️ Secret Vault" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Main Card Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tod_prompt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeColor="#E1BEE7"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- Prompt Type Tag -->
                    <TextView
                        android:id="@+id/tv_tod_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_vault_card"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="TRUTH 🕊️"
                        android:textColor="#E85D75"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Prompt Category Tag -->
                    <TextView
                        android:id="@+id/tv_tod_category_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="🌸 SWEET &amp; ROMANTIC"
                        android:letterSpacing="0.1"
                        android:textColor="?attr/colorOutline"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- The Prompt Text -->
                    <TextView
                        android:id="@+id/tv_tod_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/playfair_display"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Tap below to draw a romantic Truth or Dare card for your sweetheart! 💖"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <!-- Turn/Drawn By Info -->
                    <TextView
                        android:id="@+id/tv_tod_turn_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Ready for your next card ✨"
                        android:textColor="?attr/colorOutline"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tod_mark_done"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp"
                        android:text="Mark Completed! 💋"
                        android:textColor="#E85D75"
                        android:textSize="12sp"
                        app:cornerRadius="20dp" />

                    <TextView
                        android:id="@+id/tv_tod_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap card to flip or choose an action below ↷"
                        android:textColor="?attr/colorOutline"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Bottom Selection Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_truth"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Truth 🕊️"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="#0288D1"
                    app:cornerRadius="27dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_dare"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Dare ⚡"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="#E85D75"
                    app:cornerRadius="27dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_random_spin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Surprise Me (Spin Heart) 🎲💖"
                android:textColor="#8E24AA"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                app:strokeColor="#CE93D8"
                app:strokeWidth="1.5dp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
