<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="16dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#FF4D6D"
    app:cardBackgroundColor="#1A1D24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardCornerRadius="48dp"
            app:cardElevation="8dp"
            app:strokeWidth="2.5dp"
            app:strokeColor="#FF4D6D"
            app:cardBackgroundColor="#2D3139">

            <ImageView
                android:id="@+id/iv_incoming_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_favorite"
                app:tint="#FF4D6D"
                android:padding="22dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_incoming_partner_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="My Love"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/playfair_display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_incoming_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Incoming Video Call 📹"
            android:textColor="#FF8FA3"
            android:textSize="14sp" />

        <!-- Accept & Decline Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Decline Call -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_decline_call"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_call_end"
                    app:tint="#FFFFFF"
                    android:background="@drawable/bg_call_btn_red"
                    android:contentDescription="Decline Call"
                    android:padding="16dp"
                    android:elevation="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Decline"
                    android:textColor="#B0B7C3"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Accept Call -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_accept_call"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_videocam"
                    app:tint="#FFFFFF"
                    android:background="@drawable/bg_call_btn_green"
                    android:contentDescription="Accept Video Call"
                    android:padding="16dp"
                    android:elevation="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Accept"
                    android:textColor="#25D366"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
