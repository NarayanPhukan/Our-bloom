<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chat_settings_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="36dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/sheet_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/playfair_display"
        android:text="Chat &amp; Google Drive Backup"
        android:textColor="@color/sheet_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Safely back up your conversations to your personal Google Drive."
        android:textColor="@color/sheet_subtitle"
        android:textSize="13sp" />

    <!-- Profile Picture Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/sheet_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="#E85D75"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="@color/chat_avatar_bg">

                <ImageView
                    android:id="@+id/iv_chat_settings_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_rounded"
                    app:tint="@color/chat_header_icon" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_chat_settings_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Profile"
                    android:textColor="@color/sheet_card_title"
                    android:textSize="15sp"
                    android:fontFamily="@font/playfair_display"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Set your profile photo"
                    android:textColor="@color/sheet_card_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_profile_photo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Change"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#E85D75"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Shared Chat Wallpaper Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/sheet_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E85D75"
                    app:strokeWidth="1.5dp"
                    app:cardBackgroundColor="@color/chat_avatar_bg">

                    <ImageView
                        android:id="@+id/iv_chat_settings_wallpaper_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_photo_library_rounded"
                        app:tint="#E85D75"
                        android:padding="10dp" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shared Chat Wallpaper"
                        android:textColor="@color/sheet_card_title"
                        android:textSize="15sp"
                        android:fontFamily="@font/playfair_display"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_chat_settings_wallpaper_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Same background for both of you"
                        android:textColor="@color/sheet_card_subtitle"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_chat_wallpaper"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Set Wallpaper"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#E85D75"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_photo_library_rounded"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_chat_wallpaper"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:text="Reset"
                    android:textColor="@color/sheet_card_subtitle"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/sheet_card_stroke"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Google Account Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/sheet_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE ACCOUNT"
                android:textColor="#E85D75"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_connected_google_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:text="Not connected"
                android:textColor="@color/sheet_card_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect_google_account"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Connect Google Account"
                android:textColor="@color/sheet_button_secondary_text"
                android:textSize="13sp"
                app:backgroundTint="@color/sheet_button_secondary_bg"
                app:cornerRadius="12dp"
                app:strokeColor="@color/sheet_button_secondary_stroke"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Backup & Restore Actions Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/sheet_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BACKUP STATUS"
                android:textColor="#E85D75"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_last_backup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="Last backup: Never"
                android:textColor="@color/sheet_card_subtitle"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_backup_now"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Back Up Now to Google Drive"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#E85D75"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_cloud_upload"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_restore_backup"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Restore Chats from Google Drive"
                android:textColor="#E85D75"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E85D75"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
