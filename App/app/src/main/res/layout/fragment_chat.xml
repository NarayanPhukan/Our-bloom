<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg">

    <!-- Top Header & Contextual Selection Bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- WhatsApp-style Romantic Header -->
        <LinearLayout
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/chat_header_bg"
            android:elevation="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E85D75"
                app:strokeWidth="1.5dp"
                app:cardBackgroundColor="@color/chat_avatar_bg">

                <ImageView
                    android:id="@+id/iv_partner_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_favorite"
                    app:tint="#E85D75"
                    android:padding="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_chat_partner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Love"
                    android:textColor="@color/chat_header_text"
                    android:textSize="17sp"
                    android:fontFamily="@font/playfair_display"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_chat_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forever blooming together 🌸"
                    android:textColor="@color/chat_header_subtitle"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Google Drive & Chat Settings Button -->
            <ImageButton
                android:id="@+id/btn_chat_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_cloud_upload"
                app:tint="@color/chat_header_icon"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chat &amp; Google Drive Backup Settings"
                android:padding="10dp" />

        </LinearLayout>

        <!-- Contextual Message Selection Action Bar -->
        <LinearLayout
            android:id="@+id/layout_chat_action_bar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:background="@color/chat_header_bg"
            android:elevation="6dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_action_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_close"
                app:tint="@color/chat_header_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Selection"
                android:padding="10dp" />

            <TextView
                android:id="@+id/tv_action_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/chat_header_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="1" />

            <!-- Reply Action -->
            <ImageButton
                android:id="@+id/btn_action_reply"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_reply"
                app:tint="@color/chat_header_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reply"
                android:padding="10dp" />

            <!-- Copy Action -->
            <ImageButton
                android:id="@+id/btn_action_copy"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/chat_header_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy"
                android:padding="10dp" />

            <!-- Delete Action -->
            <ImageButton
                android:id="@+id/btn_action_delete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/chat_header_text"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete"
                android:padding="10dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Chat Messages List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_chat_message_sent" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_chat_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_favorite"
                app:tint="#40E85D75"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Secret Space 💌"
                android:textColor="@color/chat_empty_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Say something sweet to start the conversation..."
                android:textColor="@color/chat_empty_subtitle"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- WhatsApp Floating Input Bar -->
    <LinearLayout
        android:id="@+id/layout_chat_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:background="@android:color/transparent">

        <!-- WhatsApp Input & Reply Column Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Reply Preview Banner -->
            <LinearLayout
                android:id="@+id/layout_reply_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_reply_preview"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="-2dp"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <!-- Vertical Accent Stripe -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="36dp"
                    android:background="@color/chat_quote_accent"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_reply_preview_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Replying to Kuchupuchu"
                        android:textColor="@color/chat_quote_accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_reply_preview_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Message snippet..."
                        android:textColor="@color/chat_header_subtitle"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_cancel_reply"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/chat_header_subtitle"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cancel reply"
                    android:padding="6dp" />

            </LinearLayout>

            <!-- WhatsApp Pill Container -->
            <LinearLayout
                android:id="@+id/layout_whatsapp_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_whatsapp_pill"
                android:elevation="3dp"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <!-- Emoji Button -->
                <ImageButton
                    android:id="@+id/btn_chat_emoji"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_emoji_whatsapp"
                    app:tint="@color/whatsapp_icon_tint"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Emoji"
                    android:padding="8dp" />

                <!-- Input EditText -->
                <EditText
                    android:id="@+id/et_chat_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="42dp"
                    android:maxHeight="120dp"
                    android:background="@null"
                    android:hint="Type a message"
                    android:textColorHint="@color/chat_input_hint"
                    android:textColor="@color/chat_input_text"
                    android:textSize="16sp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:inputType="textCapSentences|textMultiLine" />

                <!-- Attachment / Paperclip Button -->
                <ImageButton
                    android:id="@+id/btn_attach_photo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_attach_paperclip"
                    app:tint="@color/whatsapp_icon_tint"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Attach File"
                    android:padding="8dp" />

                <!-- Camera Button -->
                <ImageButton
                    android:id="@+id/btn_chat_camera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_camera_whatsapp"
                    app:tint="@color/whatsapp_icon_tint"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Camera"
                    android:padding="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- WhatsApp Circular Action Button (Mic / Send) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_send_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="1dp"
            android:src="@drawable/ic_mic_whatsapp"
            app:fabCustomSize="48dp"
            app:tint="#FFFFFFFF"
            app:backgroundTint="@color/chat_action_pink"
            app:elevation="3dp"
            android:contentDescription="Voice Note" />

    </LinearLayout>

</LinearLayout>
