<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg">

    <!-- WhatsApp-style Romantic Header -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/chat_header_bg"
        android:elevation="4dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#E85D75"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/chat_avatar_bg">

            <ImageView
                android:id="@+id/iv_partner_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_favorite"
                app:tint="#E85D75"
                android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_chat_partner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Love"
                android:textColor="@color/chat_header_text"
                android:textSize="17sp"
                android:fontFamily="@font/playfair_display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_chat_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forever blooming together 🌸"
                android:textColor="@color/chat_header_subtitle"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Google Drive & Chat Settings Button -->
        <ImageButton
            android:id="@+id/btn_chat_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_cloud_upload"
            app:tint="@color/chat_header_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chat &amp; Google Drive Backup Settings"
            android:padding="10dp" />

    </LinearLayout>

    <!-- Chat Messages List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_chat_message_sent" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_chat_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_favorite"
                app:tint="#40E85D75"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Secret Space 💌"
                android:textColor="@color/chat_empty_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Say something sweet to start the conversation..."
                android:textColor="@color/chat_empty_subtitle"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="@color/chat_input_bar_bg">

        <!-- Attach Photo Button -->
        <ImageButton
            android:id="@+id/btn_attach_photo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_add_a_photo"
            app:tint="@color/chat_attach_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Attach Photo"
            android:padding="10dp" />

        <!-- Message Input Field -->
        <EditText
            android:id="@+id/et_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:maxHeight="120dp"
            android:background="@drawable/bg_chat_input"
            android:hint="Type a message..."
            android:textColorHint="@color/chat_input_hint"
            android:textColor="@color/chat_input_text"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Send Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_send_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_send_rounded"
            app:fabCustomSize="44dp"
            app:tint="#FFFFFFFF"
            app:backgroundTint="#E85D75"
            app:elevation="4dp"
            android:contentDescription="Send Message" />

    </LinearLayout>

</LinearLayout>
