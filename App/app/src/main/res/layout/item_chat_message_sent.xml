<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_message_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:paddingStart="64dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_sent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Embedded Quote Reply Container (WhatsApp Style) -->
        <LinearLayout
            android:id="@+id/layout_quote_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:minHeight="42dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_quote_bubble_sent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipToOutline="true"
            android:visibility="gone">

            <!-- Left colored stripe (flush against left border) -->
            <View
                android:id="@+id/view_quote_stripe"
                android:layout_width="4.5dp"
                android:layout_height="match_parent"
                android:background="#FFFFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tv_quote_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_quote_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F5F5F5"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_quote_thumb"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_quote_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_chat_image"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardPreventCornerOverlap="false"
            android:clipToOutline="true"
            app:cardBackgroundColor="#26FFFFFF"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_chat_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:maxHeight="320dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Audio Voice Note Player Container (WhatsApp / Telegram Waveform Style) -->
        <LinearLayout
            android:id="@+id/layout_chat_audio"
            android:layout_width="235dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <!-- Play / Pause Circular Action Button -->
            <ImageView
                android:id="@+id/iv_audio_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_audio_play_sent"
                android:src="@drawable/ic_play_arrow"
                android:padding="8dp"
                app:tint="#E85D75"
                android:elevation="2dp"
                android:contentDescription="Play voice note" />

            <!-- Waveform & Duration Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <!-- Interactive Waveform View -->
                <com.ourbloom.app.chat.VoiceWaveformView
                    android:id="@+id/waveform_audio"
                    android:layout_width="match_parent"
                    android:layout_height="28dp" />

                <!-- Duration & Controls Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_audio_duration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="#F5FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <!-- Playback Speed Pill (1x / 1.5x / 2x) -->
                    <TextView
                        android:id="@+id/tv_audio_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1x"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_speed_pill_sent"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="1.5dp"
                        android:paddingBottom="1.5dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Playback speed" />

                    <!-- Mic Icon Badge -->
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_mic_whatsapp"
                        app:tint="#F0FFFFFF"
                        android:contentDescription="Voice note" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_chat_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/chat_bubble_sent_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_chat_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chat_bubble_sent_time"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/iv_chat_status"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_msg_status_single_tick"
                android:contentDescription="Message status" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
