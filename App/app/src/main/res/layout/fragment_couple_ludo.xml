<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Top App Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <ImageButton
                    android:id="@+id/btn_back_ludo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="?attr/colorOnSurface" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Heartland Ludo 🎲"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_game_mode_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online Mode 🌸"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="#E91E63" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_flip_board"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Flip Board"
                        android:src="@drawable/ic_flip_board"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageButton
                        android:id="@+id/btn_switch_mode"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Switch Mode"
                        android:src="@drawable/ic_settings_rounded"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Wager Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_wager_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFF0F5"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#F8BBD0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROMANTIC WAGER"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="#AD1457"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_active_wager"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Winner gets breakfast in bed ☕"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="#37474F"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_edit_wager"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Edit Wager"
                        android:src="@drawable/ic_edit_note_rounded"
                        app:tint="#D81B60" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Top Player Banner (Partner) -->
            <LinearLayout
                android:id="@+id/layout_top_player_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_top_player_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_dark"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="#1E88E5"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_top_player_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Partner (Sky Team)"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_top_player_home_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/4 in Heartland 💖"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="#1976D2" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_top_player_turn_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_whatsapp_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Waiting"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="#1976D2" />
            </LinearLayout>

            <!-- The Ludo Board Canvas View -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="#F8BBD0"
                app:strokeWidth="2dp">

                <com.ourbloom.app.games.ludo.LudoBoardView
                    android:id="@+id/ludo_board_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Player Banner (Local Player / You) -->
            <LinearLayout
                android:id="@+id/layout_bottom_player_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_bottom_player_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_vault_card"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="#E91E63"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_bottom_player_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You (Rose Team)"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_bottom_player_home_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/4 in Heartland 💖"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="#AD1457" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_bottom_player_turn_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_whatsapp_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Your Turn 🎲"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="#2E7D32"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Action Status Banner & Animated Dice Area -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="#F8BBD0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Big 3D Animated Dice Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_roll_dice"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#E91E63"
                        app:strokeWidth="2dp">

                        <TextView
                            android:id="@+id/tv_dice_display"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="🎲"
                            android:textColor="#E91E63"
                            android:textSize="34sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_dice_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TAP DICE TO ROLL"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="#AD1457"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_ludo_action_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Roll the dice to deploy or move tokens! 🌸"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_game"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="New Duel 🔄"
                    app:cornerRadius="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_wager"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Wager 🎁"
                    app:cornerRadius="16dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
