<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="12dp">

                <ImageButton
                    android:id="@+id/btn_back_vault"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Our Future Vault 💰"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_lock_date_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_calendar"
                    app:tint="#E85D75"
                    android:contentDescription="Set Lock Date" />
            </LinearLayout>

            <!-- Hero Balance Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#F8D7DA"
                app:cardBackgroundColor="#FFF0F3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.08"
                            android:text="TOTAL JOINT SAVINGS"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="#880E4F"
                            android:textStyle="bold" />

                        <!-- Lock Badge -->
                        <LinearLayout
                            android:id="@+id/layout_lock_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_whatsapp_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_lock_closed"
                                app:tint="#880E4F" />

                            <TextView
                                android:id="@+id/tv_lock_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Locked until set date"
                                android:textColor="#880E4F"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Big Balance -->
                    <TextView
                        android:id="@+id/tv_vault_total_balance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="₹0"
                        android:textAppearance="?attr/textAppearanceDisplayMedium"
                        android:textColor="#1C1917"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <!-- Partner Contribution Split Text -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_user1_share"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="You: ₹0 (50%)"
                            android:textColor="#E85D75"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_user2_share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Partner: ₹0 (50%)"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Dual Split Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progress_partner_split"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        android:progress="50"
                        android:progressBackgroundTint="#2563EB"
                        android:progressTint="#E85D75" />

                    <!-- Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_action_contribute"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.2"
                            android:text="+ Contribute"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="#E85D75"
                            app:cornerRadius="24dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_action_withdraw"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Withdraw"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_action_add_goal"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Withdrawal Request Card (Dynamic Banner) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_active_withdrawal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#FFCDD2"
                app:cardBackgroundColor="#FFF8F8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_active_with_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Withdrawal Request Pending"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="#C62828"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_active_with_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="₹10,000 requested by Partner for Emergency repairs."
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />

                    <!-- Countdown or status text -->
                    <TextView
                        android:id="@+id/tv_active_with_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_whatsapp_pill"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="⏳ 4-day cooldown: 3d 14h remaining"
                        android:textColor="#C62828"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Approval Buttons Row -->
                    <LinearLayout
                        android:id="@+id/layout_with_approval_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_approve_withdrawal"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Approve ✓"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_decline_withdrawal"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Decline ✕"
                            android:textColor="#C62828"
                            android:textStyle="bold"
                            app:cornerRadius="20dp" />
                    </LinearLayout>

                    <!-- Cancel Button for Cooldown / Requester -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_withdrawal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:text="Cancel Withdrawal Request"
                        android:textColor="#C62828"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Goals Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Our Dream Goals 🎯"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_add_goal_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ New Goal"
                    android:textColor="#E85D75"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_savings_goals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_goals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_input"
                android:gravity="center"
                android:padding="16dp"
                android:text="No specific goals added yet. Tap '+ New Goal' to set your first target! 🌸"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOutline"
                android:visibility="gone" />

            <!-- Activity Ledger Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Contribution History 📜"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_savings_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chat_input"
                android:gravity="center"
                android:padding="16dp"
                android:text="No savings contributed yet. Tap '+ Contribute' to make your first deposit! 💖"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOutline"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
