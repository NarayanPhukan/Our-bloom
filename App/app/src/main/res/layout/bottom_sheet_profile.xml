<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_chat_settings_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="36dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@color/sheet_handle" />

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profile &amp; Couple Settings"
        android:textColor="@color/sheet_title"
        android:textSize="22sp"
        android:fontFamily="@font/playfair_display"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Set your profile picture and personalize your identity."
        android:textColor="@color/sheet_subtitle"
        android:textSize="13sp" />

    <!-- Profile Picture & Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sheet_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Circular Avatar with Camera Badge -->
            <FrameLayout
                android:id="@+id/btn_change_avatar_frame"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    app:cardCornerRadius="48dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E85D75"
                    app:strokeWidth="2.5dp"
                    app:cardBackgroundColor="@color/chat_avatar_bg">

                    <ImageView
                        android:id="@+id/iv_sheet_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person_rounded"
                        app:tint="@color/chat_header_icon" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Camera Badge -->
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_badge"
                    android:padding="6dp"
                    android:src="@drawable/ic_add_a_photo"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/pb_avatar_upload"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="#E85D75"
                android:visibility="gone" />

            <!-- User Name & Email -->
            <TextView
                android:id="@+id/tv_sheet_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your Name"
                android:textColor="@color/sheet_card_title"
                android:textSize="18sp"
                android:fontFamily="@font/playfair_display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="user@gmail.com"
                android:textColor="@color/sheet_card_subtitle"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CHANGE PHOTO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#E85D75"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_add_a_photo"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nickname Customization Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/sheet_card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/sheet_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NICKNAME FOR YOUR PARTNER"
                android:textColor="#E85D75"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="What sweet name do you call your partner?"
                android:textColor="@color/sheet_card_subtitle"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_partner_nickname"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chat_input"
                    android:hint="e.g. Kuchupuchu"
                    android:textColorHint="@color/sheet_input_hint"
                    android:textColor="@color/sheet_input_text"
                    android:textSize="14sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="textCapWords" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="Save"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#E85D75"
                    app:cornerRadius="16dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
