<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_message_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|bottom"
    android:paddingStart="8dp"
    android:paddingEnd="64dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:orientation="horizontal">

    <!-- Partner Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_chat_partner_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#E85D75"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/chat_avatar_bg">

        <ImageView
            android:id="@+id/iv_chat_partner_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_favorite"
            app:tint="#E85D75"
            android:padding="5dp"
            android:contentDescription="Partner Avatar" />
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/layout_sticker_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <!-- Sticker WebP Image (Frameless, Transparent) -->
        <ImageView
            android:id="@+id/iv_chat_sticker"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="fitCenter"
            android:contentDescription="Sticker" />

        <!-- Floating Glassmorphic Timestamp Pill -->
        <LinearLayout
            android:id="@+id/layout_sticker_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_sticker_timestamp_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sticker_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:text="12:00 PM" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
