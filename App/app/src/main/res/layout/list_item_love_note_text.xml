<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/bloom_primary"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_eco"
                app:tint="@color/bloom_secondary" />
                
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
                
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOutline"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Love note content goes here"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp" />

        <!-- Voice Note Playback Row -->
        <LinearLayout
            android:id="@+id/layout_audio_playback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_whatsapp_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_play_audio"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_call_btn_round"
                android:src="@drawable/ic_play_arrow"
                app:tint="#FFFFFF"
                android:padding="6dp"
                android:contentDescription="Play Voice Note" />

            <TextView
                android:id="@+id/tv_audio_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="🎙️ Voice Note"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/bloom_primary" />

            <TextView
                android:id="@+id/tv_audio_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0:00"
                android:textSize="12sp"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.3"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="— Author"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:fontFamily="@font/playfair_display"
            android:textSize="18sp"
            android:textColor="@color/bloom_primary"
            android:alpha="0.8"
            android:gravity="end" />

    </LinearLayout>

    <com.ourbloom.app.ui.ScratchCardView
        android:id="@+id/view_scratch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
