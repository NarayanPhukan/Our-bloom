<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shapes -->
    <style name="ShapeAppearance.OurBloom.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.OurBloom.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.OurBloom.HeadlineLg" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">@font/playfair_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.OurBloom.HeadlineMd" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/playfair_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.OurBloom.BodyLg" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.OurBloom.BodyMd" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.OurBloom.LabelCaps" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/hanken_grotesk</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="textAllCaps">true</item>
    </style>
    
    <!-- Components -->
    <style name="Widget.OurBloom.Button" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.OurBloom.Large</item>
        <item name="android:textAppearance">@style/TextAppearance.OurBloom.LabelCaps</item>
        <item name="backgroundTint">@color/bloom_primary</item>
        <item name="android:textColor">@color/bloom_on_primary</item>
    </style>

    <style name="Widget.OurBloom.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.OurBloom.Large</item>
        <item name="android:textAppearance">@style/TextAppearance.OurBloom.LabelCaps</item>
        <item name="strokeColor">@color/bloom_primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/bloom_primary</item>
    </style>

    <style name="Widget.OurBloom.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.OurBloom.Medium</item>
        <item name="boxBackgroundColor">@color/bloom_surface_container_low</item>
        <item name="boxStrokeColor">@color/bloom_primary</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <style name="Widget.OurBloom.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearance">@style/ShapeAppearance.OurBloom.Medium</item>
        <item name="cardBackgroundColor">@color/bloom_secondary_container</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
</resources>
