<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_input"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_period_row_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_admin_card"
            android:padding="4dp"
            android:src="@drawable/ic_revenue"
            app:tint="@color/admin_navy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_period_row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="October 2026"
                android:textColor="@color/admin_navy"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_period_row_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 receipts • 2% Deposit Fee"
                android:textColor="@color/admin_text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_period_row_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="+₹6.22"
                android:textColor="@color/admin_emerald"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_period_row_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23.6% of total"
                android:textColor="@color/admin_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_period_row_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="24"
        android:progressTint="@color/admin_emerald" />
</LinearLayout>
