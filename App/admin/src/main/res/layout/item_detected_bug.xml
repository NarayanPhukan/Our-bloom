<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_input"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Severity Tag + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_bug_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_rejected"
            android:fontFamily="sans-serif-black"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="CRITICAL"
            android:textColor="@color/admin_crimson"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_bug_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Payouts/Gateway"
            android:textColor="@color/admin_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_bug_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11:42 PM"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Message -->
    <TextView
        android:id="@+id/tv_bug_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="NullPointerException in Payment Gateway callback"
        android:textColor="@color/admin_text_primary"
        android:textSize="13sp" />

    <!-- Collapsible Details Toggle -->
    <LinearLayout
        android:id="@+id/layout_toggle_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_toggle_details_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="▼ Show Technical Stacktrace"
            android:textColor="@color/admin_blue"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Collapsible Stacktrace Container -->
    <LinearLayout
        android:id="@+id/layout_stacktrace_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/admin_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_bug_stacktrace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="java.lang.NullPointerException..."
            android:textColor="@color/admin_text_secondary"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_stack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/admin_card"
            android:text="Copy Full Diagnostic Report"
            android:textColor="@color/admin_emerald"
            android:textSize="11sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/admin_emerald"
            app:strokeWidth="1dp" />
    </LinearLayout>

</LinearLayout>
