<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_couple_names"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Partner 1 &amp; Partner 2"
                android:textColor="@color/admin_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_detail_couple_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="ID: 6a91c996e82f78851994a8bc"
                android:textColor="@color/admin_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_detail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_cancel"
            app:tint="@color/admin_text_muted" />
    </LinearLayout>

    <!-- Vault Overview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_admin_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL VAULT BALANCE"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_detail_total_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="₹1,000"
                    android:textColor="@color/admin_emerald"
                    android:textSize="22sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_detail_freeze_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_verified"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ACTIVE"
                android:textColor="@color/admin_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_detail_partner_split"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Partner 1: ₹500 (50%) • Partner 2: ₹500 (50%)"
            android:textColor="@color/admin_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_detail_lock_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Lock: Unlocked"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_freeze_toggle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Freeze Vault"
            android:textColor="@color/admin_crimson"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/admin_crimson" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_adjust_balance"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Adjust Balance"
            android:textColor="@color/admin_navy"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/admin_navy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_share_statement"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Share CSV"
            android:textColor="@color/admin_navy"
            android:textSize="11sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Payment Statement Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_statement_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="STATEMENT OF PAYMENTS"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/progress_statement_loading"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_couple_statement"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tv_empty_statement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No transactions recorded for this couple yet."
            android:textColor="@color/admin_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
