<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_admin_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_treasury"
            app:tint="@color/admin_navy" />

        <TextView
            android:id="@+id/tv_audit_admin_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Admin: Narayan"
            android:textColor="@color/admin_navy"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_audit_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="19 Sep 2026, 17:30"
            android:textColor="@color/admin_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_audit_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Reason: Created new 1-year PNB FD #PNB-FD-9842"
        android:textColor="@color/admin_text_primary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_audit_change_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="FD Principal: ₹0.00 → ₹7,00,000.00 • Liquid: ₹2,40,000.00"
        android:textColor="@color/admin_blue"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_audit_document_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="📄 Confirmation Doc: Attached PNB_FD_Receipt_2026.pdf"
        android:textColor="@color/admin_emerald"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
