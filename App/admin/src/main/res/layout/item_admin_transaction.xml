<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_admin_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Icon Badge -->
    <FrameLayout
        android:id="@+id/badge_tx_type"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_status_verified"
        android:padding="8dp">

        <ImageView
            android:id="@+id/img_tx_type"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/admin_emerald" />
    </FrameLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Deposit • Partner"
            android:textColor="@color/admin_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_tx_utr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="UTR: 123456789012"
            android:textColor="@color/admin_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_tx_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Savings contribution"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_admin_tx_fee_breakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Gross: ₹1,000.00 • Fee: ₹20.00 • Net: ₹980.00 [Settlement: PENDING]"
            android:textColor="@color/admin_text_secondary"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Amount Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tx_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="+₹500"
            android:textColor="@color/admin_emerald"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_tx_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Just now"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
