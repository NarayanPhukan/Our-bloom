<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh_revenue"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- HEADER BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_revenue_back"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/admin_navy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Revenue &amp; Treasury"
                        android:textColor="@color/admin_navy"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time Financial Invariants &amp; Solvency"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_solvency_summary_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_verified"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="100% COVERED"
                    android:textColor="@color/admin_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TIME FILTER CHIPS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_all_time"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="All Time"
                        android:textSize="11sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_this_month"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="This Month"
                        android:textSize="11sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_this_week"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="This Week"
                        android:textSize="11sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_filter_today"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Today"
                        android:textSize="11sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- CARD 1: OURBLOOM REVENUE (EARNED INCOME) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_admin_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_revenue"
                        app:tint="@color/admin_emerald" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="OURBLOOM EARNED REVENUE"
                        android:textColor="@color/admin_navy"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_total_revenue_events_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 receipts"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_net_revenue_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    android:text="₹0.00"
                    android:textColor="@color/admin_emerald"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total legitimate company revenue recognized (zero customer principal)"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="10sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/admin_divider" />

                <!-- 3 Columns Breakdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Fees -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PLATFORM FEES"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_fees_revenue_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0.00"
                            android:textColor="@color/admin_navy"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_fees_revenue_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2% on deposits"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/admin_divider" />

                    <!-- Gifts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GIFT REVENUE"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_gifts_revenue_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0.00"
                            android:textColor="@color/admin_navy"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_gifts_revenue_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Net margin"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@color/admin_divider" />

                    <!-- Subscriptions -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SUBSCRIPTIONS"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_subs_revenue_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0.00"
                            android:textColor="@color/admin_navy"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_subs_revenue_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Couple passes"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 2: CUSTOMER FUNDS (LIABILITIES — NON-REVENUE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_admin_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_vault_safe"
                        app:tint="@color/admin_navy" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="CUSTOMER FUNDS (FIDUCIARY LIABILITIES)"
                        android:textColor="@color/admin_navy"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_outline"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="NEVER REVENUE"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VAULT PRINCIPAL HELD"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_customer_vault_principal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0.00"
                            android:textColor="@color/admin_navy"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tv_customer_vaults_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 couple vaults"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PENDING PAYOUTS"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_pending_withdrawals_obligation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0.00"
                            android:textColor="@color/admin_amber"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tv_pending_withdrawals_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 requests awaiting disbursement"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 3: PAYU SETTLEMENTS (CASHFLOW & GATEWAY STATUS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_admin_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_ledger"
                        app:tint="@color/admin_blue" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="PAYU SETTLEMENTS &amp; CASHFLOW"
                        android:textColor="@color/admin_navy"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync_payu_settlements"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Sync PayU"
                        android:textColor="@color/admin_blue"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="14dp"
                        app:iconTint="@color/admin_blue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Settled Cash -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BANK SETTLED CASH"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_payu_settled_cash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0.00"
                            android:textColor="@color/admin_emerald"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tv_payu_settled_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 settled txns"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Pending In-Transit -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IN-TRANSIT RECEIVABLE"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_payu_pending_cash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="₹0.00"
                            android:textColor="@color/admin_amber"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tv_payu_pending_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 pending PayU batch"
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_payu_reconciliation_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reconciliation Rate: 100.0% • Last Settlement: AXISCN1470216334"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- CARD 4: VAULT TREASURY & PHYSICAL BACKING (ACTIVE PNB FD POSITION) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_admin_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_treasury"
                        app:tint="@color/admin_navy" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-bold"
                        android:text="VAULT TREASURY &amp; PHYSICAL BACKING"
                        android:textColor="@color/admin_navy"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_record_treasury_position"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Record PNB Position"
                        android:textSize="10sp"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- DUAL SOLVENCY METRICS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Immediate Liquidity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 IMMEDIATE LIQUIDITY"
                            android:textColor="@color/admin_emerald"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_immediate_liquidity_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="0.0%"
                            android:textColor="@color/admin_emerald"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tv_immediate_liquidity_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Liquid Bank Cash ÷ Vault Principal"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <!-- Total Backing Coverage -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟡 EXPECTED COVERAGE"
                            android:textColor="@color/admin_amber"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_expected_coverage_ratio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="0.0%"
                            android:textColor="@color/admin_navy"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tv_expected_coverage_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(Liquid + InTransit + PNB FD) ÷ Principal"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- PHYSICAL BACKING ALLOCATION BREAKDOWN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="🔵 PHYSICAL ALLOCATION BREAKDOWN"
                        android:textColor="@color/admin_navy"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tv_pnb_fd_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• Active PNB FD Principal: ₹0.00 (Ref: None recorded)"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_liquid_reserve_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• Liquid Checking Reserve: ₹0.00"
                        android:textColor="@color/admin_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_payu_intransit_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="• PayU Receivable (In-Transit): ₹0.00"
                        android:textColor="@color/admin_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_fd_interest_yield_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="• Projected FD Yield: ₹0.00 (OurBloom Interest Income — separated)"
                        android:textColor="@color/admin_emerald"
                        android:textSize="10sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <!-- FD CONFIRMATION DOCUMENT (PDF ATTACHMENT & AUDIT) -->
                <LinearLayout
                    android:id="@+id/layout_fd_confirmation_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="📄 PNB e-FD CONFIRMATION PDF"
                            android:textColor="@color/admin_navy"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/badge_fd_doc_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_pending"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="No PDF Attached"
                            android:textColor="@color/admin_amber"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Document Details (Shown when attached) -->
                    <LinearLayout
                        android:id="@+id/layout_doc_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_fd_doc_filename"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="PNB_Receipt.pdf"
                            android:textColor="@color/admin_text_primary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_fd_doc_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Uploaded by admin • 19 Sep 2026"
                            android:textColor="@color/admin_text_muted"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_fd_doc"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:text="View / Download"
                                android:textSize="10sp"
                                app:cornerRadius="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_replace_fd_doc"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:text="Replace PDF"
                                android:textColor="@color/admin_navy"
                                android:textSize="10sp"
                                app:cornerRadius="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Upload Button (Shown when no doc attached) -->
                    <LinearLayout
                        android:id="@+id/layout_doc_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload the official PNB e-FD certificate PDF to verify physical backing."
                            android:textColor="@color/admin_text_secondary"
                            android:textSize="10sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_upload_fd_doc"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:text="+ Upload Confirmation PDF"
                            android:textSize="10sp"
                            app:cornerRadius="6dp" />
                    </LinearLayout>

                    <!-- Upload Progress Indicator -->
                    <ProgressBar
                        android:id="@+id/pb_fd_doc_upload"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 5: CANONICAL REVENUE LEDGER & BATCHES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Revenue &amp; Treasury Ledger"
                    android:textColor="@color/admin_navy"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_record_manual_revenue"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:text="+ Record Revenue"
                    android:textSize="10sp"
                    app:cornerRadius="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_revenue_csv"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Export CSV"
                    android:textSize="10sp"
                    app:cornerRadius="6dp" />
            </LinearLayout>

            <!-- LEDGER FILTER TABS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_all_revenue"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="All Revenue"
                        android:textSize="10sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_fees_only"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="Fees (2%)"
                        android:textSize="10sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_gifts_only"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="Gifts"
                        android:textSize="10sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_subs_only"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="Subscriptions"
                        android:textSize="10sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_settlements_only"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:text="PayU Batches"
                        android:textSize="10sp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_audit_only"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Treasury Audit"
                        android:textSize="10sp"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_revenue_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_revenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="No revenue entries recorded for this filter"
                android:textColor="@color/admin_text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
