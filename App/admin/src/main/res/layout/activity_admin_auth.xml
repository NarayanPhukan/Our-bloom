<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Bloom Shield / Icon -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_status_verified"
            android:padding="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_lock"
                app:tint="@color/admin_emerald" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/admin_app_name"
            android:textColor="@color/admin_text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/admin_tagline"
            android:textColor="@color/admin_text_secondary"
            android:textSize="14sp" />

        <!-- Credentials Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_admin_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="ADMINISTRATOR LOGIN"
                android:textColor="@color/admin_text_muted"
                android:textSize="11sp" />

            <!-- Mobile Number Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="MOBILE NUMBER"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="+91"
                    android:textColor="@color/admin_emerald"
                    android:textSize="15sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/admin_divider" />

                <EditText
                    android:id="@+id/et_admin_mobile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:fontFamily="monospace"
                    android:hint="8822361549"
                    android:inputType="phone"
                    android:text="8822361549"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Password Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ADMIN PASSWORD"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/admin_text_muted"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_admin_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:hint="Enter password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/admin_text_primary"
                    android:textColorHint="@color/admin_text_muted"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error Feedback -->
            <TextView
                android:id="@+id/tv_auth_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Invalid mobile number or password."
                android:textColor="@color/admin_crimson"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Login Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_admin_login"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/admin_emerald_dark"
                android:fontFamily="sans-serif-black"
                android:text="Log In to Command Center"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Biometric Quick Unlock (if device supports) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_biometric"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/admin_card"
            android:text="Quick Unlock with Biometrics"
            android:textColor="@color/admin_emerald"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_fingerprint"
            app:iconTint="@color/admin_emerald"
            app:strokeColor="@color/admin_card_border"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Confidential &amp; Restricted Access • Our Bloom Vaults"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
