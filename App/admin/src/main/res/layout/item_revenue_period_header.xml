<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_period_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_admin_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/iv_period_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_input"
        android:padding="5dp"
        android:src="@drawable/ic_ledger"
        app:tint="@color/admin_navy" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_period_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="October 2026"
            android:textColor="@color/admin_navy"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_period_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 receipts recognized"
            android:textColor="@color/admin_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_period_total_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="+₹6.22"
            android:textColor="@color/admin_emerald"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_period_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_status_verified"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="MONTH TOTAL"
            android:textColor="@color/admin_emerald"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
