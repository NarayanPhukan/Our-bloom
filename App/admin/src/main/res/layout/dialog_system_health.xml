<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_admin_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="System Health Radar"
                android:textColor="@color/admin_navy"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Real-time latency &amp; microservice telemetry"
                android:textColor="@color/admin_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh_health"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh"
            android:src="@drawable/ic_refresh"
            app:tint="@color/admin_navy" />

        <ImageButton
            android:id="@+id/btn_close_health"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_cancel"
            app:tint="@color/admin_text_muted" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_health"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_health_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Global Status Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_verified"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_health_global_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="ALL SYSTEMS OPERATIONAL"
                    android:textColor="@color/admin_emerald"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_health_global_latency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Global response latency: ~28 ms"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_health_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Just now"
                android:textColor="@color/admin_text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Service Cards Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- API Server -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Node.js Production Server"
                        android:textColor="@color/admin_navy"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_health_server_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Uptime: 2d 4h • Memory: 128 MB"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_server_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_verified"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="ONLINE"
                    android:textColor="@color/admin_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- MongoDB Atlas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="MongoDB Atlas Cluster"
                        android:textColor="@color/admin_navy"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_health_mongo_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Host: Atlas Cluster • Replica Set"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_mongo_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_verified"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="CONNECTED"
                    android:textColor="@color/admin_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Firestore Cloud -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Firebase Firestore Realtime"
                        android:textColor="@color/admin_navy"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_health_firestore_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latency: 14 ms • Sync active"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_firestore_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_verified"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="HEALTHY"
                    android:textColor="@color/admin_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PayU Gateway -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="PayU India Payment Gateway"
                        android:textColor="@color/admin_navy"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_health_payu_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode: Live Production • Auto Settlement Sync"
                        android:textColor="@color/admin_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_payu_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_verified"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="CONFIGURED"
                    android:textColor="@color/admin_emerald"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
