<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_card"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_revenue"
                app:tint="@color/admin_emerald" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Record Canonical Revenue"
                android:textColor="@color/admin_navy"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_close_revenue_dialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_cancel"
                app:tint="@color/admin_text_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Revenue Type"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_revenue_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_type_gift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Gift"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_type_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Subscription"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rb_type_fee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Fee / Adjust"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Item / Pass Title"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_revenue_title"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. Couple Premium Pass - Annual"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- GROSS AMOUNT (₹) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Gross Amount (₹)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_revenue_gross_amount"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 500.00"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- SELLER PAYABLE / COST (₹) (For gifts) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Seller Payable / Cost of Goods (₹)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_revenue_seller_cost"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 350.00 (Owed to merchant, 0 if digital)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- COUPLE ID -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Couple ID / Partner Name"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_revenue_couple_id"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 6a91c996e82f78851994a8bc"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- MANUAL ENTRY REASON -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Reason / Reference (Immutable Requirement)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_revenue_entry_reason"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. Offline UPI gift sale / manual pass receipt"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_manual_revenue"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/admin_navy"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_manual_revenue"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/admin_emerald"
                android:text="Commit Receipt"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
