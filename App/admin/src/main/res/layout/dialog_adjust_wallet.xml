<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_admin_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Adjust Vault Balance"
        android:textColor="@color/admin_rose"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_adjust_current_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Current Balance: ₹12,450"
        android:textColor="@color/admin_text_secondary"
        android:textSize="13sp" />

    <!-- New Balance Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NEW TOTAL BALANCE (₹) *"
        android:textColor="@color/admin_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_adjust_new_balance"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:fontFamily="sans-serif-black"
        android:hint="12450"
        android:inputType="numberDecimal"
        android:paddingHorizontal="14dp"
        android:textColor="@color/admin_blue"
        android:textColorHint="@color/admin_text_muted"
        android:textSize="18sp" />

    <!-- Reason Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="AUDIT REASON FOR ADJUSTMENT *"
        android:textColor="@color/admin_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_adjust_reason"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="e.g. Disputed transaction resolution"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/admin_text_primary"
        android:textColorHint="@color/admin_text_muted"
        android:textSize="13sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_adjust"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="@color/admin_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_adjust"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/admin_rose"
            android:text="Save Balance"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
