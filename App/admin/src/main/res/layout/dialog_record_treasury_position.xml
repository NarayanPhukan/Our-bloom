<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_admin_card"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_treasury"
                app:tint="@color/admin_navy" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Record Active PNB FD Position"
                android:textColor="@color/admin_navy"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_close_treasury_dialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_cancel"
                app:tint="@color/admin_text_muted" />
        </LinearLayout>

        <!-- DISCLAIMER BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_status_pending"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Manual Banking Reconciliation Notice"
                android:textColor="@color/admin_amber"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="This action does not create or modify an FD at Punjab National Bank. It records and reconciles the treasury backing position within OurBloom."
                android:textColor="@color/admin_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- BANK NAME (FIXED) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Bank Name"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_treasury_bank_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:enabled="false"
            android:paddingHorizontal="12dp"
            android:text="Punjab National Bank (PNB)"
            android:textColor="@color/admin_navy"
            android:textSize="13sp" />

        <!-- FD REFERENCE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="PNB FD Reference Number"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_treasury_fd_ref"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. PNB-FD-2026-9842"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- FD PRINCIPAL AMOUNT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="FD Principal Amount (₹)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_treasury_fd_principal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 700000"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- FD INTEREST RATE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Contracted FD Interest Rate (% p.a.)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_treasury_fd_rate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 7.25 (Required)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- MATURITY VALUE (OPTIONAL / CONTRACTED) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Projected Maturity Value (₹)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_treasury_fd_maturity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 752150"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- LIQUID BANK CASH RESERVE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Liquid Bank Reserve in Checking Account (₹)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_treasury_liquid_reserve"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. 240000"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- PNB E-FD CONFIRMATION PDF -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PNB e-FD Confirmation Receipt (PDF / Image)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_dialog_current_doc_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No document currently attached"
                android:textColor="@color/admin_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dialog_pick_fd_doc"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Select PDF / Image"
                    android:textSize="10sp"
                    app:cornerRadius="6dp" />

                <TextView
                    android:id="@+id/tv_dialog_selected_doc_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/admin_navy"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- AUDIT LOG REASON -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Update Reason (Required for Audit Trail)"
            android:textColor="@color/admin_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_treasury_update_reason"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="e.g. Rolled over 1-year PNB FD #9842"
            android:paddingHorizontal="12dp"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_treasury"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/admin_navy"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_treasury_position"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/admin_navy"
                android:text="Save Position"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
