<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_admin_card"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_input"
        android:padding="6dp"
        android:src="@drawable/ic_ledger"
        app:tint="@color/admin_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_batch_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Batch: 2026-09-17"
                android:textColor="@color/admin_navy"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_batch_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_verified"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="SETTLED"
                android:textColor="@color/admin_emerald"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_batch_utr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Merchant UTR: AXISCN1470216334"
            android:textColor="@color/admin_text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_batch_txns_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14 customer deposits reconciled"
            android:textColor="@color/admin_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_batch_settled_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="₹840.50"
        android:textColor="@color/admin_emerald"
        android:textSize="15sp" />

</LinearLayout>
