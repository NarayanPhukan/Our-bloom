<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_admin_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_statement_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/admin_emerald" />

        <TextView
            android:id="@+id/tv_statement_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Deposit • Partner"
            android:textColor="@color/admin_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_statement_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="+₹100"
            android:textColor="@color/admin_emerald"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Breakdown row -->
    <TextView
        android:id="@+id/tv_statement_breakdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Gross: ₹102.00 • Fee: ₹2.00 • Net: ₹100.00 [Settled via PayU]"
        android:textColor="@color/admin_text_secondary"
        android:textSize="11sp" />

    <!-- UTR and Note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_statement_ref"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Ref: AXISCN1467867098"
            android:textColor="@color/admin_text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_statement_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-09-15 14:06"
            android:textColor="@color/admin_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
